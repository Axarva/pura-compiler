-- presentation_ja.pura (Final: Text Restored, Transitions Fixed)

-- 1. MODEL --------------------------------------------------------------------
initialModel : List String
let initialModel = ["0", "微積試験勉強！！"]

-- 2. LOGIC & HELPERS ----------------------------------------------------------
changeSlide : List String -> Int -> List String
let changeSlide = model => delta =>
  let currentIdx = parseInt (head model) in
  let newIdx = currentIdx + delta in
  let finalIdx = if newIdx < 0 then 0 else if newIdx > 12 then 12 else newIdx in
  cons (toString finalIdx) (tail model)

addTodo : List String -> List String
let addTodo = model =>
  let input = prompt "新しいタスク名:" in
  if input == "" then model 
  else cons (head model) (cons input (tail model)) REQUIRES BrowserPrompt

removeTop : List String -> List String
let removeTop = model =>
  let slideIdx = head model in
  let todos = tail model in
  if isEmpty todos then model else cons slideIdx (tail todos)

mapTodos : (String -> Html String) -> List String -> List (Html String)
let mapTodos = f => list =>
  if isEmpty list then [] else cons (f (head list)) (mapTodos f (tail list))

update : String -> List String -> List String
let update = msg => model =>
  if msg == "NEXT" then changeSlide model 1
  else if msg == "PREV" then changeSlide model (0 - 1)
  else if msg == "ADD_TODO" then addTodo model
  else if msg == "DEL_TODO" then removeTop model
  else model

-- 3. VIEW HELPERS -------------------------------------------------------------

slideWrapper : List (Html String) -> Html String
let slideWrapper = content => 
  div [ htmlClass "slide-container" ] [
    div [ htmlClass "slide" ] content,
    div [ htmlClass "nav-controls" ] [
      button [ htmlOnClick "PREV", htmlClass "nav-btn" ] [ text "←" ],
      button [ htmlOnClick "NEXT", htmlClass "nav-btn" ] [ text "→" ]
    ]
  ]

slideWrapperStable : List (Html String) -> Html String
let slideWrapperStable = content => 
  div [ htmlClass "slide-container" ] [
    div [ htmlClass "slide no-anim" ] content,
    div [ htmlClass "nav-controls" ] [
      button [ htmlOnClick "PREV", htmlClass "nav-btn" ] [ text "←" ],
      button [ htmlOnClick "NEXT", htmlClass "nav-btn" ] [ text "→" ]
    ]
  ]

fragmentClass : Bool -> String
let fragmentClass = isVisible => 
  if isVisible then "fragment visible" else "fragment"

codeSpan : String -> String -> Html String
let codeSpan = cls => txt => 
  div [ htmlClass ("inline-code " ++ cls) ] [ text txt ]

kw : String -> Html String
let kw = t => codeSpan "kw" t
str : String -> Html String
let str = t => codeSpan "str" t
fn : String -> Html String
let fn = t => codeSpan "fn" t
cmt : String -> Html String
let cmt = t => codeSpan "cmt" t
redCmt : String -> Html String
let redCmt = t => codeSpan "cmt-red" t
norm : String -> Html String
let norm = t => codeSpan "norm" t
line : List (Html String) -> Html String
let line = content => div [ htmlClass "code-line" ] content

-- 4. SLIDES -------------------------------------------------------------------

-- Slide 0: Title
viewTitle : Int -> Html String
let viewTitle = idx =>
  slideWrapper [
    h1 [ htmlClass "title main-title" ] [ text "Pura" ],
    p [ htmlClass "subtitle main-subtitle" ] [ text "UI指向関数型言語" ],
    div [ htmlClass "title-info" ] [
        p [] [ text "情報メディア特別演習 I" ],
        p [] [ text "202513228　ティムシナ　アサルヴァ" ],
        p [] [ text "アドバイザー教員：中井 央" ]
    ]
  ]

-- Slide 1: The Problem (Part 1)
viewProblemJS : Int -> Html String
let viewProblemJS = idx =>
  slideWrapper [
    h1 [] [ text "課題：実行時の脆弱性" ],
    p [ htmlClass "subtitle" ] [ text "動的型付けが引き起こす静かなる失敗" ],
    div [ htmlClass "two-column" ] [
        div [] [
            p [] [ text "JavaScriptの場合 (実行時エラー)" ],
            div [ htmlClass "code-block" ] [
                line [ kw "function", norm " calc(cart) {" ],
                line [ norm "  ", kw "let", norm " total ", kw "=", norm " 0;" ],
                line [ norm "  ", kw "for", norm " (", kw "let", norm " item ", kw "of", norm " cart.items) {" ],
                line [ norm "    ", redCmt "// バグ: \"10\" + 0 = \"010\"" ],
                line [ norm "    total ", kw "+=", norm " item.price;" ],
                line [ norm "  }" ],
                line [ norm "  ", kw "return", norm " total;" ],
                line [ norm "}" ]
            ]
        ],
        div [ htmlClass "hidden-block" ] [
             p [] [ text "." ], 
             div [ htmlClass "code-block" ] [ line [ norm " " ] ]
        ]
    ]
  ]

-- Slide 2: The Problem (Part 2)
viewProblemPura : Int -> Html String
let viewProblemPura = idx =>
  slideWrapperStable [
    h1 [] [ text "課題：実行時の脆弱性" ],
    p [ htmlClass "subtitle" ] [ text "動的型付けが引き起こす静かなる失敗" ],
    div [ htmlClass "two-column" ] [
        div [] [
            p [] [ text "JavaScriptの場合 (実行時エラー)" ],
            div [ htmlClass "code-block" ] [
                line [ kw "function", norm " calc(cart) {" ],
                line [ norm "  ", kw "let", norm " total ", kw "=", norm " 0;" ],
                line [ norm "  ", kw "for", norm " (", kw "let", norm " item ", kw "of", norm " cart.items) {" ],
                line [ norm "    ", redCmt "// バグ: \"10\" + 0 = \"010\"" ],
                line [ norm "    total ", kw "+=", norm " item.price;" ],
                line [ norm "  }" ],
                line [ norm "  ", kw "return", norm " total;" ],
                line [ norm "}" ]
            ]
        ],
        div [ htmlClass "fragment visible" ] [
             p [] [ text "一方、Puraで同じコードを書くと..." ],
             div [ htmlClass "code-block" ] [
                line [ kw "let", fn " calc", norm " ", kw "=", norm " total ", kw "=>", norm " price ", kw "=>" ],
                line [ norm "  total ", kw "+", norm " price" ]
             ],
             div [ htmlClass "error-box" ] [
                div [ htmlClass "error-title" ] [ text "🛑 Type Mismatch Error" ],
                div [ htmlClass "error-msg" ] [ text "Cannot add types Int and String." ],
                div [ htmlClass "error-detail" ] [ text "  | total + price" ],
                div [ htmlClass "error-detail" ] [ text "  |         ^^^^^ Expected Int, got String" ]
             ]
        ]
    ]
  ]

-- Slide 3: Pre-Reveal
viewPreReveal : Int -> Html String
let viewPreReveal = idx =>
  slideWrapper [
    div [ htmlClass "center-suspense" ] [
        h1 [ htmlClass "wait-text" ] [ text "実は..." ],
        p [ htmlClass "wait-sub" ] [ text "お気づきでしょうか？" ]
    ]
  ]

-- Slide 4: Reveal
viewReveal : Int -> Html String
let viewReveal = idx =>
  slideWrapper [
    div [ htmlClass "fragment visible" ] [
        h1 [ htmlClass "title reveal-title" ] [ text "このプレゼン自体が Pura製 です。" ],
        p [] [ text "MVU アーキテクチャを使った状態管理機能付きアプリです。" ],
        div [ htmlClass "code-block reveal-code" ] [
             line [ kw "let", fn " viewReveal", norm " ", kw "=", norm " idx ", kw "=>" ],
             line [ norm "  slideWrapper [" ],
             line [ norm "    h1 [] [ text ", str "\"このプレゼン自体が...\"", norm " ]" ],
             line [ norm "  ]" ]
        ],
        div [ htmlClass "stats-container" ] [
            p [] [ text "JavaScript: 0行" ],
            p [] [ text "Runtime Errors: 0" ]
        ],
        div [ htmlClass "repo-link-container" ] [
            a [ htmlHref "https://github.com/Axarva/pura-compiler/tree/main/class_materials/final", htmlClass "repo-link" ] [
                text "Check Source on GitHub" 
            ]
        ]
    ]
  ]

-- Slide 5: Demo
viewTodoItem : String -> Html String
let viewTodoItem = item =>
  li [ htmlClass "todo-item" ] [ text item ]

viewDemo : List String -> Html String
let viewDemo = model =>
  slideWrapper [
    h1 [ htmlClass "title" ] [ text "実証デモ" ],
    p [] [ text "以下のアプリは Pura Runtime 上で動作しています。" ],
    div [ htmlClass "todo-container" ] [
      ul [] (mapTodos viewTodoItem (tail model))
    ],
    div [] [
      button [ htmlOnClick "ADD_TODO", htmlClass "btn-primary" ] [ text "+ タスク追加" ],
      text " ", 
      button [ htmlOnClick "DEL_TODO", htmlClass "btn-secondary" ] [ text "先頭を完了" ]
    ]
  ]

-- Slide 6: Comparison (Part 1)
viewComparisonJS : Int -> Html String
let viewComparisonJS = idx =>
  slideWrapper [
    h1 [] [ text "比較分析" ],
    div [ htmlClass "two-column" ] [
      div [] [
        div [ htmlClass "col-header" ] [ text "JavaScript (命令型)" ],
        div [ htmlClass "code-block" ] [
          line [ kw "function", fn " sum", norm "(list) {" ],
          line [ norm "  ", kw "let", norm " total ", kw "=", norm " 0;" ],
          line [ norm "  ", kw "for", norm " (", kw "let", norm " i", kw "=", norm "0; i<list.length; i++) {" ],
          line [ norm "    total ", kw "+=", norm " list[i];" ],
          line [ norm "  }" ],
          line [ norm "  ", kw "return", norm " total;" ],
          line [ norm "}" ]
        ]
      ],
      div [ htmlClass "hidden-block" ] [
         div [ htmlClass "col-header" ] [ text "." ],
         div [ htmlClass "code-block" ] [ line [ norm " " ] ]
      ]
    ],
    div [ htmlClass "hidden-block" ] [ p [] [ text "." ] ]
  ]

-- Slide 7: Comparison (Part 2)
viewComparisonPura : Int -> Html String
let viewComparisonPura = idx =>
  slideWrapperStable [
    h1 [] [ text "比較分析" ],
    div [ htmlClass "two-column" ] [
      div [] [
        div [ htmlClass "col-header" ] [ text "JavaScript (命令型)" ],
        div [ htmlClass "code-block" ] [
          line [ kw "function", fn " sum", norm "(list) {" ],
          line [ norm "  ", kw "let", norm " total ", kw "=", norm " 0;" ],
          line [ norm "  ", kw "for", norm " (", kw "let", norm " i", kw "=", norm "0; i<list.length; i++) {" ],
          line [ norm "    total ", kw "+=", norm " list[i];" ],
          line [ norm "  }" ],
          line [ norm "  ", kw "return", norm " total;" ],
          line [ norm "}" ]
        ]
      ],
      div [ htmlClass "fragment visible" ] [
        div [ htmlClass "col-header" ] [ text "Pura (宣言型)" ],
        div [ htmlClass "code-block" ] [
          line [ kw "let", fn " sum", norm " ", kw "=", norm " list ", kw "=>" ],
          line [ norm "  ", kw "if", norm " isEmpty list ", kw "then" ],
          line [ norm "    0" ],
          line [ norm "  ", kw "else" ],
          line [ norm "    head list ", kw "+", norm " sum (tail list)" ]
        ]
      ]
    ],
    div [ htmlClass "fragment visible" ] [
        p [] [ text "「手順」ではなく「定義」を書くことで、状態管理のバグを排除します。" ]
    ]
  ]

-- Slide 8: Inference
viewInference : Int -> Html String
let viewInference = idx =>
  slideWrapper [
    h1 [] [ text "Hindley-Milner 型推論" ],
    p [ htmlClass "subtitle" ] [ text "コンパイル時における正当性の保証" ],
    ul [] [
      li [ htmlClass (fragmentClass (idx >= 1)) ] [ text "型推論 + 明示的契約：内部は完全推論、境界は明示的" ],
      li [ htmlClass (fragmentClass (idx >= 2)) ] [ text "主要型 (Principal Types)：最も汎用的な型を特定" ],
      li [ htmlClass (fragmentClass (idx >= 3)) ] [ text "型安全：型付けされたプログラムは不正な動作をしない" ]
    ]
  ]

-- Slide 9-12: Effects (Step by Step)
viewEffectsStep : Int -> Html String
let viewEffectsStep = step =>
  let wrapper = if step == 1 then slideWrapper else slideWrapperStable in
  
  wrapper [
    h1 [] [ text "副作用の管理 (Effects)" ],
    -- p [ htmlClass "subtitle" ] [ text "外部世界へのアクセスを明示的に制御" ],
    
    ul [] [
      li [ htmlClass "visible" ] [ text "JavaScriptやPythonとは異なり、副作用は明示的です。" ],
      li [ htmlClass "visible" ] [ text "関数は必要な「権限」を宣言しなければなりません。" ]
    ],
    
    div [ htmlClass "effects-grid" ] [
        -- 1. Pure
        div [ htmlClass (if step >= 1 then "effect-card visible" else "effect-card hidden-block") ] [
            div [ htmlClass "col-header" ] [ text "1. 純粋関数" ],
            div [ htmlClass "code-block small-code" ] [
                line [ cmt "-- xの入力に対して計算を行いその結果を出す（単射）" ],
                line [ kw "let", fn " double", norm " ", kw "=", norm " x ", kw "=>" ],
                line [ norm "  x ", kw "*", norm " 2" ]
            ]
        ],
        -- 2. Realistic Impure
        div [ htmlClass (if step >= 1 then "effect-card visible" else "effect-card hidden-block") ] [
            div [ htmlClass "col-header" ] [ text "2. 一般的な副作用" ],
            div [ htmlClass "code-block small-code" ] [
                line [ cmt "-- 画面で文字を表示する外部世界へのアクセス" ],
                line [ kw "let", fn " log", norm " ", kw "=", norm " msg ", kw "=>" ],
                line [ fn "  print", norm " msg" ]
            ]
        ],
        -- 3. Funny Impure
        div [ htmlClass (if step >= 2 then "effect-card fragment visible" else "effect-card hidden-block") ] [
            div [ htmlClass "col-header" ] [ text "3. 危険な副作用" ],
            div [ htmlClass "code-block small-code" ] [
                line [ cmt "-- 国際的副作用" ],
                line [ kw "let", fn " nuke", norm " ", kw "=", norm " () ", kw "=>" ],
                line [ fn "  launchMissiles", norm " ()" ]    
            ]
        ],
        -- 4. Pura Solution
        div [ htmlClass (if step >= 2 then "effect-card fragment visible" else "effect-card hidden-block") ] [
            div [ htmlClass "col-header" ] [ text "4. Puraの解決策" ],
            div [ htmlClass "code-block small-code" ] [
                line [ cmt "-- 権限を宣言したPuraコード" ],
                line [ kw "let", fn " main", norm " ", kw "=", norm " { ... }" ],
                line [ kw "  REQUIRES", norm " Console" ]
            ]
        ]
    ]
  ]

-- Slide 13: Roadmap
viewRoadmap : Int -> Html String
let viewRoadmap = idx =>
  slideWrapper [
    h1 [] [ text "今後の展望" ],
    ul [] [
      li [ htmlClass "fragment visible" ] [ text "代数的エフェクト (Algebraic Effects)" ],
      li [ htmlClass "fragment visible" ] [ text "WebAssembly (Wasm) バックエンド" ],
      li [ htmlClass "fragment visible" ] [ text "標準ライブラリの拡充" ]
    ]
  ]

-- Slide 14: Summary (Matome)
viewSummary : Int -> Html String
let viewSummary = idx =>
  slideWrapper [
    h1 [ htmlClass "title" ] [ text "まとめ" ],
    
    div [ htmlClass "two-column" ] [
      div [] [
        div [ htmlClass "col-header center-text" ] [ text "課題と解決" ],
        ul [] [
          li [ htmlClass "fragment visible" ] [ text "動的型付けで「静かなる失敗」排除" ],
          li [ htmlClass "fragment visible" ] [ text "宣言的記述で状態管理バグを防ぐ" ],
          li [ htmlClass "fragment visible" ] [ text "JavaScriptより読みやすい表現" ]
        ]
      ],
      div [] [
        div [ htmlClass "col-header center-text" ] [ text "技術と実証" ],
        ul [] [
          li [ htmlClass "fragment visible" ] [ text "型推論とエフェクトシステムで安全性" ],
          li [ htmlClass "fragment visible" ] [ text "MVUアーキテクチャでのUI構築を実現" ],
          li [ htmlClass "fragment visible" ] [ text "実証：このスライド自体Pura製アプリ" ]
        ]
      ]
    ],
    
    p [ htmlClass "copyright" ] [ text "Built with Pura Compiler 2025" ]
  ]

-- 6. MAIN DISPATCH ------------------------------------------------------------
view : List String -> Html String
let view = model =>
  let idx = parseInt (head model) in
  
  if idx == 0 then viewTitle idx
  else if idx == 1 then viewProblemJS idx
  else if idx == 2 then viewProblemPura idx
  else if idx == 3 then viewPreReveal idx
  else if idx == 4 then viewReveal idx
  else if idx == 5 then viewDemo model
  else if idx == 6 then viewComparisonJS idx
  else if idx == 7 then viewComparisonPura idx
  else if idx == 8 then viewInference 3
  -- Split Effects slide into 4 steps
  else if idx == 9 then viewEffectsStep 1
  else if idx == 10 then viewEffectsStep 2
  else if idx == 11 then viewRoadmap idx
  else viewSummary idx

-- 7. ENTRY POINT --------------------------------------------------------------
main : Unit
let main = {
  print "Starting Presentation..."
} REQUIRES ConsoleWrite, BrowserPrompt