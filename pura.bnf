# =================================
# 1. Top-Level Program Structure
# =================================

<program> ::= <top_level_declaration>*

<top_level_declaration> ::= <type_declaration>
                          | <function_definition>

# =================================
# 2. Declarations
# =================================

<type_declaration> ::= <identifier> ":" <type>

<function_definition> ::= "let" <identifier> "=" <param_list> <body> <requires_clause>?

<param_list> ::= ( <identifier> "=>" )*

<body> ::= <block> | <expr>

<requires_clause> ::= "REQUIRES" <effect> ( "," <effect> )*

# =================================
# 3. Type System
# =================================

<type> ::= <basic_type> ( "->" <type> )?

<basic_type> ::= "Int" 
               | "String" 
               | "Bool" 
               | "Unit" 
               | "Msg"
               | <list_type> 
               | <html_type> 
               | <attr_type>
               | "(" <type> ")"

<list_type>      ::= "List" <basic_type>
<html_type>      ::= "Html" <basic_type>
<attr_type>      ::= "Attribute" <basic_type>

# =================================
# 4. Expressions (Precedence: Lowest to Highest)
# =================================

<expr> ::= <or_expr>

# Level 1: Logical OR
<or_expr> ::= <and_expr> ( "||" <and_expr> )*

# Level 2: Logical AND
<and_expr> ::= <comparison_expr> ( "&&" <comparison_expr> )*

# Level 3: Comparison
<comparison_expr> ::= <additive_expr> ( <comp_op> <additive_expr> )*
<comp_op> ::= "==" | "!=" | "<" | ">" | "<=" | ">="

# Level 4: Addition / Subtraction
<additive_expr> ::= <concat_expr> ( ( "+" | "-" ) <concat_expr> )*

# Level 5: String Concatenation
<concat_expr> ::= <multiplicative_expr> ( "++" <multiplicative_expr> )*

# Level 6: Multiplication / Division
<multiplicative_expr> ::= <unary_expr> ( ( "*" | "/" ) <unary_expr> )*

# Level 7: Unary Operators
<unary_expr> ::= "!" <unary_expr> | <application>

# Level 8: Function Application (Curried)
<application> ::= <atom>+

# Level 9: Atomic Expressions (Base Case)
<atom> ::= <literal>
         | <variable>
         | <if_expr>
         | <let_expr>
         | <block>
         | <do_block>
         | "(" <expr> ")"
         | "(" <bin_op> ")"

# =================================
# 5. Sub-Expressions and Literals
# =================================

<if_expr>  ::= "if" <expr> "then" <expr> "else" <expr>

<let_expr> ::= "let" <identifier> "=" <expr> "in" <expr>

<block>    ::= "{" ( <expr> ";" )* "}"

<do_block> ::= "do" "{" <expr>* "}"

<literal> ::= <int_literal> 
            | <string_literal> 
            | <bool_literal> 
            | <list_literal> 
            | <unit_literal>

<unit_literal>   ::= "()"
<list_literal>   ::= "[" ( <expr> ("," <expr>)* )? "]"
<bool_literal>   ::= "True" | "False"
<bin_op>         ::= "+" | "-" | "*" | "/" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "&&" | "||"

<effect> ::= "ConsoleWrite" | "FileIO" | "Network" | "BrowserPrompt"

